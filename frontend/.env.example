# Copy this file to .env.local for local development and set the same variables in Vercel.
# NEVER commit real secrets or put the Supabase service_role / secret key in any VITE_ variable.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
